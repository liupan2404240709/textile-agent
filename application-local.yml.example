# 本地私有配置模板
# ---------------------------------------------------------------
# 用法：复制本文件为项目根目录下的 application-local.yml，填入真实密钥。
# application-local.yml 已被 .gitignore 忽略，不会被提交到仓库。
#
# 也可以完全不用本文件，改为设置同名环境变量（见 README「配置密钥」章节）：
#   DASHSCOPE_API_KEY / ALIYUN_ACCESS_KEY_ID / ALIYUN_ACCESS_KEY_SECRET
#   ALIYUN_SPEECH_APP_KEY / ZHIPU_API_KEY / BAIDU_API_KEY
# 环境变量优先级高于本文件。
# ---------------------------------------------------------------

langchain4j:
  community:
    dashscope:
      # 阿里云百炼 DashScope，同一个 Key 供对话 / 向量 / 图片 / 语音识别复用
      chat-model:
        api-key: sk-your-dashscope-api-key
      embedding-model:
        api-key: sk-your-dashscope-api-key
      streaming-chat-model:
        api-key: sk-your-dashscope-api-key
      image-model:
        api-key: sk-your-dashscope-api-key
      image-generation-model:
        api-key: sk-your-dashscope-api-key
      speech-recognition:
        api-key: sk-your-dashscope-api-key
        # 智能语音交互控制台创建的项目 AppKey
        app-key: your-nls-app-key

aliyun:
  speech:
    # 阿里云 RAM 子账号 AccessKey，仅用于语音识别（与上面的 DashScope Key 不是一回事）
    access-key-id: your-aliyun-access-key-id
    access-key-secret: your-aliyun-access-key-secret
    app-key: your-nls-app-key
    region: cn-shanghai

dashscope:
  api-key: sk-your-dashscope-api-key

rag:
  embedding:
    api-key: sk-your-dashscope-api-key

mcp:
  # 联网搜索 MCP 服务密钥，留空则自动降级为不联网
  zhipu:
    api-key: your-zhipu-api-key
  baidu:
    api-key: your-baidu-api-key

spring:
  datasource:
    username: root
    password: your-mysql-password
